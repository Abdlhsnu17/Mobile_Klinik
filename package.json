{
  "name": "sistem-klinik",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:all": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "node scripts/free-dev-ports.js && npm --prefix apps/backend run dev",
    "build": "npm run build:packages && npm run build:backend && npm run build:frontend",
    "build:packages": "npm --prefix packages/types run build && npm --prefix packages/utils run build && npm --prefix packages/config run build && npm --prefix packages/database run build",
    "build:backend": "npm --prefix apps/backend run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "start:frontend": "npm --prefix apps/frontend run start",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm --prefix apps/backend run lint",
    "lint:frontend": "npm --prefix apps/frontend run lint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix apps/backend test -- --runInBand",
    "test:frontend": "npm --prefix apps/frontend test",
    "test:selenium": "node selenium/support/clean-screenshots.mjs && node --test selenium/e2e/full-regression.test.mjs selenium/e2e/navigation-smoke.test.mjs",
    "test:selenium:core": "node selenium/support/clean-screenshots.mjs && node --test selenium/e2e/full-regression.test.mjs",
    "test:selenium:smoke": "node selenium/support/clean-screenshots.mjs && node --test selenium/e2e/navigation-smoke.test.mjs",
    "test:selenium:headed": "SELENIUM_HEADLESS=false npm run test:selenium",
    "test:selenium:core:headed": "SELENIUM_HEADLESS=false npm run test:selenium:core",
    "test:selenium:smoke:headed": "SELENIUM_HEADLESS=false npm run test:selenium:smoke",
    "selenium:smoke:headed": "npm run test:selenium:smoke:headed",
    "docker:up": "docker compose -f docker/compose.yml up --build",
    "docker:dev": "docker compose --env-file docker/dev.env -f docker/compose.yml -f docker/compose.override.yml up --build",
    "docker:down": "docker compose --env-file docker/dev.env -f docker/compose.yml down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "concurrently": "^8.2.2",
    "eslint": "9.39.5",
    "selenium-webdriver": "^4.46.0",
    "tsx": "^4.21.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.10",
    "next": {
      ".": "^16.1.7",
      "postcss": "^8.5.10"
    }
  }
}
