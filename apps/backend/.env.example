APP_PORT=3000
API_PORT=4004
API_CONTAINER_PORT=4004

# Untuk VPS, ganti localhost dengan domain/IP publik.
FRONTEND_URL=http://localhost:3001
BACKEND_PUBLIC_URL=http://localhost:4004

# Frontend memakai proxy Next.js ke backend agar browser tidak perlu hardcode localhost backend.
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://backend:4004

MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_DATABASE=sistem_klinik
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistem_klinik
DB_USER=root
DB_PASSWORD=

# Wajib diganti dengan string random panjang sebelum deploy.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1h
AUTH_COOKIE_NAME=clinic_auth_token
AUTH_COOKIE_MAX_AGE_MS=3600000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SIMKLAB <noreply@example.com>
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
NOTIFICATION_POLL_INTERVAL_MS=30000

# Opsional: jalankan phpMyAdmin dengan `docker compose --profile tools up -d`.
PHPMYADMIN_PORT=8082
