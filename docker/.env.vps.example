# Salin file ini ke `.env` di root repository pada VPS dan ganti semua nilai CHANGE_ME.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_database_password
MYSQL_DATABASE=sistem_klinik
MYSQL_USER=klinik
MYSQL_PASSWORD=CHANGE_ME_application_database_password

JWT_SECRET=CHANGE_ME_minimum_32_random_characters
JWT_EXPIRES_IN=1h
AUTH_COOKIE_NAME=clinic_auth_token
AUTH_COOKIE_MAX_AGE_MS=3600000

# URL publik. Gunakan HTTPS setelah reverse proxy/domain aktif.
FRONTEND_URL=https://klinik.example.com
BACKEND_PUBLIC_URL=https://klinik.example.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_REALTIME_URL=

# Port frontend hanya terbuka di loopback agar diproksikan oleh Nginx/Caddy.
BIND_ADDRESS=127.0.0.1
APP_PORT=3001

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
NOTIFICATION_POLL_INTERVAL_MS=30000
